{
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.renderWhitespace": "all",
    "editor.rulers": [
        50,
        75,
        100
    ],
    "editor.wordWrap": "on",
    "explorer.copyRelativePathSeparator": "/",
    "files.associations": {
        // needs extension uniquevision.vscode-plpgsql-lsp
        "*.pg.sql": "postgres",
        "*.plpgsql": "postgres",
        // config & creds
        "**/.aws/*": "ini"
    },
    "files.exclude": {
        "**/.git": false
    },
    "git.inputValidation": true,
    "mssql.autoDisableNonTSqlLanguageService": true,
    "mssql.intelliSense.lowerCaseSuggestions": true,
    // https://github.com/OmniSharp/omnisharp-vscode/issues/3003
    "omnisharp.useGlobalMono": "never",
    "plpgsqlLanguageServer.definitionFiles": [
        // Support glob.
        "**/*.pg.sql",
        "**/*.psql",
        "**/*.pgsql",
        "**/*.plpgsql"
    ],
    "workbench.colorTheme": "Default Dark+"
}